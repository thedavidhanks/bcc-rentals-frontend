# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- LibreBooking ------------------------------------------------------------
# Base URL of the LibreBooking install (no trailing slash, no /Web suffix).
LIBREBOOKING_BASE_URL="http://bccreservations.thedavidhanks.com"
LIBREBOOKING_SERVICE_USER=""
LIBREBOOKING_SERVICE_PASS=""

# Numeric resource IDs from LibreBooking (Application Management → Resources).
LB_RESOURCE_ID_TENT=""
LB_RESOURCE_ID_POPCORN=""
LB_RESOURCE_ID_PARTY_ROOM=""

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- PayPal ------------------------------------------------------------------
PAYPAL_ENV="sandbox" # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="BCC Rentals <rentals@bachmancc.org>"

# --- Storage (Upstash Redis) -------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
