# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
#
# Parsed like Next.js (dotenv + dotenv-expand) by both `npm run dev` and
# scripts/deploy/set-staging-env.sh: inline `# comments` after a value are
# ignored, "double"/'single' quotes are stripped, and `$VAR` / `${VAR}` are
# expanded (not inside 'single quotes'). The deploy script refuses to run if a
# reference is undefined or a required value is empty.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- PayPal ------------------------------------------------------------------
PAYPAL_ENV="sandbox" # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="BCC Rentals <rentals@bachmancc.org>"
STAFF_NOTIFICATION_EMAIL="reservations@bachmancc.org"

# --- Storage (Upstash Redis) -------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Neon (PostgreSQL) ----------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-rough-shadow-at0azjvb-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_DEV="postgresql://user:password@ep-cool-field-at8or3b4.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# To run (and deploy staging) against the dev branch instead, reference it:
# DATABASE_URL="$DATABASE_URL_DEV"